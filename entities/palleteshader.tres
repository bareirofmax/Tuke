code = "shader_type canvas_item;
render_mode blend_mix;

uniform sampler2D original;
uniform sampler2D new;
uniform int ColorCount;



void fragment() {
	vec4 n_out8p0;
// Texture2D:8
	n_out8p0 = texture(TEXTURE, UV);


// IntParameter:7
	int n_out7p0 = ColorCount;


	vec4 n_out6p0;
// Expression:6
	n_out6p0 = vec4(0.0, 0.0, 0.0, 0.0);
	{
		vec2 new_uv = vec2(0,0);
		//code sourced from tutorial by DashNothing @ www.youtube.com/watch?v=ME6of_bGkKY 
		for (int i = 0; i < n_out7p0; i++) {
			float u = (float(i) + 0.5) / float(n_out7p0);
			float v = 0.5; 
			vec2 uv = vec2(u, v);
			vec4 ogColor = texture(original, uv);
			float dist = distance(n_out8p0, ogColor);
			if (dist <= 0.2) {
				new_uv = uv;
				break;
			}
		}
		
		n_out6p0 = texture(new, new_uv);
	}


// Output:0
	COLOR.rgb = vec3(n_out6p0.xyz);


}
"
